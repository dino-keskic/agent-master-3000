{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Agent Master 3000",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "/bin/bash",
      "args": ["${workspaceFolder}/.vscode/start-board.sh", "live"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Agent Master 3000 (scratch)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "/bin/bash",
      "args": ["${workspaceFolder}/.vscode/start-board.sh", "scratch"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
